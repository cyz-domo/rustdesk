From f25d298c757a0f209692cebde658c45a5a82001c Mon Sep 17 00:00:00 2001
From: TIANXUAN13 <2926930231@qq.com>
Date: Sun, 20 Sep 2026 19:10:02 +0800
Subject: [PATCH 3/3] fix(rendezvous): carry socket_addr_v6 through the
 same_intranet path

The IPv6 introduction patch only filled the PunchHole branch. When hbbs
judges peers same_intranet it sends FetchLocalAddr instead, and there
A's self-reported v6 socket was dropped; on the reply side, LocalAddr's
socket_addr_v6 was never forwarded into PunchHoleResponse. Result: a
same-CGNAT-egress (mis)judgment silently forfeits IPv6 direct on both
legs. Forward both fields so start_ipv6 spawns on each side.
---
 src/rendezvous_server.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/rendezvous_server.rs b/src/rendezvous_server.rs
index 6f7ccc2..6a1e15a 100644
--- a/src/rendezvous_server.rs
+++ b/src/rendezvous_server.rs
@@ -903,6 +903,9 @@ impl RendezvousServer {
             socket_addr: la.local_addr.clone(),
             pk: self.get_pk(&la.version, la.id).await,
             relay_server: la.relay_server,
+            // B echoes its own IPv6 punch socket here (handle_intranet's start_ipv6);
+            // A only runs its IPv6 leg when this field carries a port.
+            socket_addr_v6: la.socket_addr_v6,
             ..Default::default()
         };
         p.set_is_local(true);
@@ -1018,6 +1021,10 @@ impl RendezvousServer {
                 msg_out.set_fetch_local_addr(FetchLocalAddr {
                     socket_addr,
                     relay_server,
+                    // Same forwarding as PunchHole: without it B's handle_intranet sees
+                    // peer_addr_v6.port()==0 and never spawns the IPv6 leg, so a
+                    // same_intranet (mis)judgment silently forfeits IPv6 direct.
+                    socket_addr_v6,
                     ..Default::default()
                 });
             } else {
